{
    "permissions": {
        "allow": [
            "Bash(git status *)",
            "Bash(git diff *)",
            "Bash(./gradlew *)",
            "Bash(cd backend && ./gradlew *)",
            "Bash(cd frontend && pnpm run *)",
            "Bash(git add *)",
            "Bash(git commit -m *)",
            "Bash(git merge *)",
            "Bash(git fetch *)",
            "Bash(git ls-tree *)",
            "Bash(docker compose *)",
            "Bash(./scripts/create-table.sh)",
            "Bash(gh pr comment *)",
            "Bash(gh pr view *)",
            "Bash(gh pr diff *)",
            "Bash(gh pr create *)",
            "Bash(gh run *)",
            "Bash(gh api repos/*/issues/*/comments*)",
            "Bash(pnpm run *)",
            "Bash(pnpm install)",
            "Bash(pnpm add *)",
            "Bash(pnpm view *)",
            "Bash(pnpm exec playwright *)",
            "Bash(pnpm exec oxlint *)",
            "Bash(pnpm exec prettier *)",
            "Bash(pnpm exec tsc *)",
            "Bash(pnpm exec vitest *)",
            "Bash(pnpm dlx *)",
            "Bash(echo)",
            "Bash(cat)",
            "Bash(tee)",
            "Skill(pr)",
            "Skill(pr:*)"
        ],
        "ask": [
            "Bash(gh pr merge *)",
            "Bash(gh api --method *)",
            "Bash(gh api -X *)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./secrets/**)",
            "Read(./.swiss-stage-oauth.env)",
            "Bash(git push origin main)",
            "Bash(curl *)",
            "Bash(wget *)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 ./.claude/hooks/smart_approve.py",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}